---
import '../styles/global.css';

const year = new Date().getFullYear();
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f6f5f0">
    <meta name="description" content="GPT Business 的品牌与业务介绍正在整理中，敬请期待。">
    <title>GPT Business — 让下一步更清晰</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="GPT Business 首页">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        <span>GPT <strong>Business</strong></span>
      </a>
      <nav class="main-nav" aria-label="主导航">
        <a href="#services">业务方向</a>
        <a href="#about">关于</a>
        <a href="#contact">联系</a>
        <a class="nav-status" href="#services"><span class="status-dot"></span>网站筹备中</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero section-wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> GPT BUSINESS · 你的品牌主页</p>
          <h1 id="hero-title">让下一步，<br><span>更清晰。</span></h1>
          <p class="hero-intro">一个好的开始，值得一个清晰的介绍。GPT Business 的业务信息正在整理中，敬请期待。</p>
          <a class="text-link" href="#services">了解业务方向 <span aria-hidden="true">↘</span></a>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="art-orbit orbit-one"></div>
          <div class="art-orbit orbit-two"></div>
          <div class="art-core"><span>GB</span><i></i></div>
          <div class="art-note note-top"><span class="note-kicker">A NEW CHAPTER</span><span>从这里开始</span></div>
          <div class="art-note note-bottom"><span class="note-number">01</span><span>IDEAS INTO ACTION</span></div>
          <div class="art-spark spark-one">✳</div>
          <div class="art-spark spark-two">✳</div>
        </div>
        <div class="hero-footnote"><span>01 / 01</span><span>网站正在搭建 · 更多内容即将发布</span></div>
      </section>

      <section class="services section-wrap" id="services" aria-labelledby="services-title">
        <div class="section-label"><span>01</span><span>业务方向</span></div>
        <div class="section-content">
          <h2 id="services-title">先说清楚你能<br>为访客做什么。</h2>
          <p class="section-intro">用简洁、具体的内容介绍业务。以下信息目前为占位提示，发布前请替换为真实且确认可公开的内容。</p>
          <div class="offer-grid">
            <article class="offer-card">
              <span class="card-index">A / 你提供什么</span>
              <h3>产品或服务</h3>
              <p>补充你提供的产品、服务或解决方案。</p>
            </article>
            <article class="offer-card">
              <span class="card-index">B / 服务对象</span>
              <h3>你帮助谁</h3>
              <p>说明适合的客户、团队或使用场景。</p>
            </article>
            <article class="offer-card">
              <span class="card-index">C / 核心价值</span>
              <h3>解决什么问题</h3>
              <p>用真实、明确的内容描述业务价值。</p>
            </article>
          </div>
        </div>
      </section>

      <section class="about section-wrap" id="about" aria-labelledby="about-title">
        <div class="section-label"><span>02</span><span>关于</span></div>
        <div class="section-content about-content">
          <p class="eyebrow"><span class="eyebrow-line"></span> ABOUT GPT BUSINESS</p>
          <h2 id="about-title">一个好的介绍，<br>从真实信息开始。</h2>
          <p class="section-intro">这里可以介绍品牌、团队或项目的由来。请在上线前补充经过确认的介绍，不要保留占位提示作为正式业务说明。</p>
        </div>
      </section>

      <section class="contact section-wrap" id="contact" aria-labelledby="contact-title">
        <div class="contact-panel">
          <div>
            <p class="contact-kicker">03 / CONTACT</p>
            <h2 id="contact-title">保持联系。</h2>
            <p>在这里添加你确认公开的邮箱、社交账号或其他联系渠道。</p>
          </div>
          <span class="contact-placeholder">联系方式待补充</span>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand footer-brand" href="#top">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        <span>GPT <strong>Business</strong></span>
      </a>
      <span class="footer-note">清晰表达，从这里开始。</span>
      <span class="copyright">© {year} GPT Business</span>
    </footer>
  </body>
</html>
